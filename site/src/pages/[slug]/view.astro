---
/**
 * /<slug>/view/ — the model viewer with its channel switcher.
 *
 * THE POINT OF THIS PAGE: a rotating model proves nothing. The channel flip
 * discharges a measured claim on contact — a repo asserts a number in prose,
 * and here the reader sees which texels it refers to.
 *
 * brand supplies the mechanism. Everything subject-specific on this page —
 * channel labels, captions, legends, camera names — is read from the subject's
 * own view.json. No subject vocabulary is hardcoded here, and adding a channel
 * must never require editing this file.
 */
import '../../styles/global.css';
import BaseLayout from '@mcptoolshop/site-theme/components/BaseLayout.astro';
import { config } from '../../site-config';
import { loadModelViews } from '../../lib/model-views.mjs';

export async function getStaticPaths() {
  return loadModelViews().map(({ slug, view }) => ({ params: { slug }, props: { view } }));
}

const { slug } = Astro.params;
const { view } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const modelBase = `${base}/model/${slug}`;

const channels = view.channels.map((c) => ({
  ...c,
  url: `${modelBase}/${c.texture}`,
}));
const initial = channels[0];
---

<BaseLayout
  title={`${slug} — model viewer`}
  description={view.subject ?? `Interactive model and evidence channels for ${slug}.`}
  logoBadge={config.logoBadge}
  brandName={config.brandName}
  repoUrl={config.repoUrl}
  npmUrl={config.npmUrl}
  footerText={config.footerText}
  nav={[{ href: base + '/', label: 'Home' }]}
>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-2xl font-semibold">{slug}</h1>
    {view.subject && <p class="mt-1 text-sm opacity-70">{view.subject}</p>}

    <div class="mt-6 rounded-lg border border-white/10 overflow-hidden">
      <model-viewer
        id="mv"
        src={`${modelBase}/${view.asset}`}
        alt={view.subject ?? `3D model for ${slug}`}
        camera-controls
        touch-action="pan-y"
        loading="lazy"
        reveal="manual"
        shadow-intensity="0"
        environment-image="neutral"
        tone-mapping="none"
        style="width:100%;aspect-ratio:4/3;background:#0b0b0e;"
        data-channels={JSON.stringify(channels.map((c) => ({
          id: c.id,
          url: c.url,
          filter: c.filter,
          categorical: c.categorical,
          caption: c.caption ?? '',
        })))}
      >
        <button slot="poster" id="reveal-btn"
          class="w-full h-full flex items-center justify-center text-sm opacity-80">
          Load 3D model
        </button>
      </model-viewer>
    </div>

    <!-- Channel switcher. Order and labels come from view.json. -->
    <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Channel">
      {channels.map((c, i) => (
        <button
          type="button"
          data-channel={c.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="channel-btn rounded border border-white/15 px-3 py-1.5 text-sm"
        >
          {c.label}
          {c.categorical && <span class="ml-1.5 opacity-50 text-xs">exact</span>}
        </button>
      ))}
    </div>

    <p id="caption" class="mt-3 text-sm opacity-75 min-h-[1.5rem]">{initial?.caption ?? ''}</p>
    <p id="mv-status" class="mt-1 text-xs opacity-50" role="status"></p>

    <!-- Legend, per channel, when the subject declared one. -->
    {channels.some((c) => c.legend) && (
      <div class="mt-4">
        {channels.filter((c) => c.legend).map((c) => (
          <div class="legend mt-2 hidden" data-legend-for={c.id}>
            <div class="text-xs uppercase tracking-wide opacity-50">{c.label}</div>
            <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {Object.entries(c.legend!).map(([colour, meaning]) => (
                <li class="flex items-center gap-2">
                  <span class="inline-block h-3 w-3 rounded-sm border border-white/20"
                        style={`background:${colour}`}></span>
                  <span class="opacity-80">{meaning}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}

    {view.cameras && view.cameras.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Camera">
        {view.cameras.map((cam) => (
          <button type="button" data-orbit={cam.orbit}
                  class="camera-btn rounded border border-white/10 px-2.5 py-1 text-xs opacity-80">
            {cam.label}
          </button>
        ))}
      </div>
    )}

    {view.provenance && (
      <details class="mt-8 rounded border border-white/10 p-4 text-sm">
        <summary class="cursor-pointer opacity-80">Provenance</summary>
        <dl class="mt-3 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1">
          {view.provenance.derived_from && (<><dt class="opacity-50">derived from</dt><dd>{view.provenance.derived_from}</dd></>)}
          {view.provenance.recipe && (<><dt class="opacity-50">recipe</dt><dd><code class="text-xs">{view.provenance.recipe}</code></dd></>)}
          {view.provenance.source_repo && (<><dt class="opacity-50">source</dt><dd>{view.provenance.source_repo}</dd></>)}
          {view.provenance.source_spec && (<><dt class="opacity-50">spec</dt><dd>{view.provenance.source_spec}</dd></>)}
          {view.provenance.receipt && (
            <><dt class="opacity-50">receipt</dt>
              <dd>
                {view.provenance.receipt.value === null || view.provenance.receipt.value === undefined
                  ? <span class="opacity-60">not yet measured</span>
                  : <>{view.provenance.receipt.value} <span class="opacity-60">{view.provenance.receipt.metric}</span></>}
                {view.provenance.receipt.against && <span class="opacity-50"> vs {view.provenance.receipt.against}</span>}
              </dd></>
          )}
        </dl>
      </details>
    )}
  </section>
</BaseLayout>

<script>
  // model-viewer is bundled from node_modules, never a CDN: a Pages-hosted
  // page that reaches out to a third-party host for its renderer has a
  // runtime dependency nobody declared.
  import '@google/model-viewer';

  // glTF sampler filter constants (Filter enum in gltf-2.0.ts, verified in the
  // installed package rather than assumed).
  const NEAREST = 9728;
  const LINEAR = 9729;

  type ChannelData = {
    id: string;
    url: string;
    filter: 'linear' | 'nearest';
    categorical: boolean;
    caption: string;
  };

  const mv = document.getElementById('mv') as any;
  const statusEl = document.getElementById('mv-status')!;
  const captionEl = document.getElementById('caption')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.channel-btn')];
  const legends = [...document.querySelectorAll<HTMLElement>('.legend')];
  const channels: ChannelData[] = JSON.parse(mv.dataset.channels);

  // Poster dismissal needs BOTH listeners, and the reason is not obvious.
  //
  // The slotted button's own `click` fires for keyboard activation (Enter or
  // Space on a focused button), and that path works. It does NOT fire for a
  // real mouse press: `camera-controls` installs pointer handlers on the host
  // and captures the pointer on pointerdown, so no `click` is ever dispatched
  // to the slotted child. Measured, not assumed — a synthetic `btn.click()`
  // loaded the model while a real click at the same coordinates did nothing,
  // with `elementFromPoint` confirming the button was the topmost element.
  //
  // So the host gets a pointerdown listener for mouse/touch, and the button
  // keeps its click listener for keyboard and assistive tech. Either one alone
  // leaves a group of users looking at a poster that never dismisses.
  const reveal = () => {
    if (!mv.loaded) mv.dismissPoster();
  };
  document.getElementById('reveal-btn')?.addEventListener('click', reveal);
  mv.addEventListener('pointerdown', reveal);

  const textureCache = new Map<string, unknown>();

  async function applyChannel(id: string) {
    const ch = channels.find((c) => c.id === id);
    if (!ch || !mv.model) return;

    let texture = textureCache.get(ch.url);
    if (!texture) {
      texture = await mv.createTexture(ch.url);
      if (!texture) {
        statusEl.textContent = `could not load channel "${id}"`;
        return;
      }
      textureCache.set(ch.url, texture);
    }

    const filter = ch.filter === 'nearest' ? NEAREST : LINEAR;
    // CHECK-MIP, leg one: minFilter NEAREST (not one of the *_MIPMAP_*
    // variants) means three.js samples level 0 only, so a categorical channel
    // can never be read through a blended mip level. Set it BEFORE the texture
    // is attached so no frame is ever drawn with the default filtering.
    (texture as any).sampler.setMinFilter(filter);
    (texture as any).sampler.setMagFilter(filter);

    for (const material of mv.model.materials) {
      material.pbrMetallicRoughness.baseColorTexture.setTexture(texture);
    }

    // CHECK-MIP, leg two: read the filter back rather than trusting the write.
    // A declared filter that did not take is exactly the unenforceable
    // guarantee this design refuses elsewhere, so it is surfaced, not assumed.
    if (ch.categorical) {
      const s = (texture as any).sampler;
      const ok = s.minFilter === NEAREST && s.magFilter === NEAREST;
      statusEl.textContent = ok
        ? 'categorical channel — nearest filtering verified, no mip blending'
        : `WARNING: categorical channel is filtered ${s.minFilter}/${s.magFilter}, not nearest. ` +
          'Colours shown may be blends of classes that were never measured.';
      statusEl.classList.toggle('text-amber-400', !ok);
    } else {
      statusEl.textContent = '';
      statusEl.classList.remove('text-amber-400');
    }

    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.channel === id));
    captionEl.textContent = ch.caption;
    for (const l of legends) l.classList.toggle('hidden', l.dataset.legendFor !== id);
  }

  for (const b of buttons) {
    b.addEventListener('click', () => applyChannel(b.dataset.channel!));
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('.camera-btn')) {
    b.addEventListener('click', () => {
      mv.cameraOrbit = b.dataset.orbit;
    });
  }

  mv.addEventListener('load', () => {
    const first = channels[0];
    if (first) applyChannel(first.id);
  });
</script>

<style>
  .channel-btn[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.12);
    border-color: rgb(255 255 255 / 0.35);
  }
  model-viewer::part(default-progress-bar) {
    background: rgb(255 255 255 / 0.4);
  }
</style>
